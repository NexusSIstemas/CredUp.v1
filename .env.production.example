# Copie este arquivo para .env.production e substitua todos os valores CHANGE_ME.
APP_ORIGIN=https://credup.seudominio.com.br
APP_HTTP_PORT=8088

DATABASE_NAME=credup
DATABASE_USER=credup
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=720
JWT_REFRESH_COOKIE_SECURE=true

ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

MERCADO_PAGO_AMBIENTE=producao
MERCADO_PAGO_ACCESS_TOKEN=CHANGE_ME
MERCADO_PAGO_API_URL=https://api.mercadopago.com
MERCADO_PAGO_WEBHOOK_SECRET=CHANGE_ME

# Backup externo opcional pelo rclone. Não coloque token do Google neste arquivo.
# O nome do remoto é criado diretamente na VPS com: rclone config
BACKUP_GOOGLE_DRIVE_REMOTE=google-drive
BACKUP_GOOGLE_DRIVE_DIRECTORY=CredUp/backups
BACKUP_GOOGLE_DRIVE_RETENTION_DAYS=30
