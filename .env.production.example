# Copie este arquivo para .env.production e substitua todos os valores CHANGE_ME.
APP_ORIGIN=https://credup.seudominio.com.br
APP_HTTP_PORT=8088

DATABASE_NAME=credup
DATABASE_USER=credup
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRATION_MINUTES=480

ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
